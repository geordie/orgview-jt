<% content_for :title, @data_version.name %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= @data_version.name %></h1>
  <div>
    <% unless @data_version.is_active? %>
      <%= link_to "Activate This Version", activate_data_version_path(@data_version),
          method: :patch,
          class: "btn btn-success",
          data: { confirm: "Make '#{@data_version.name}' the active version?" } %>
    <% end %>
    <%= link_to "← Back to Versions", data_versions_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Version Details</h5>
      </div>
      <div class="card-body">
        <dl class="row">
          <dt class="col-sm-3">Name:</dt>
          <dd class="col-sm-9">
            <%= @data_version.name %>
            <% if @data_version.is_active? %>
              <span class="badge bg-success ms-2">Active</span>
            <% end %>
          </dd>

          <dt class="col-sm-3">Status:</dt>
          <dd class="col-sm-9">
            <span class="badge bg-<%= @data_version.status == 'active' ? 'success' : @data_version.status == 'draft' ? 'warning' : 'secondary' %>">
              <%= @data_version.status.capitalize %>
            </span>
          </dd>

          <dt class="col-sm-3">Snapshot Date:</dt>
          <dd class="col-sm-9"><%= @data_version.snapshot_date.strftime("%B %d, %Y at %I:%M %p") %></dd>

          <dt class="col-sm-3">Created:</dt>
          <dd class="col-sm-9"><%= @data_version.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>

          <% if @data_version.description.present? %>
            <dt class="col-sm-3">Description:</dt>
            <dd class="col-sm-9"><%= @data_version.description %></dd>
          <% end %>
        </dl>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Data Statistics</h5>
      </div>
      <div class="card-body">
        <div class="d-flex justify-content-between mb-2">
          <span>Employees:</span>
          <strong><%= number_with_delimiter(@employee_count) %></strong>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span>Roles:</span>
          <strong><%= number_with_delimiter(@role_count) %></strong>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span>Squads:</span>
          <strong><%= number_with_delimiter(@squad_count) %></strong>
        </div>
        <div class="d-flex justify-content-between">
          <span>Squad Assignments:</span>
          <strong><%= number_with_delimiter(@squads_employees_count) %></strong>
        </div>
      </div>
    </div>

    <% unless @data_version.is_active? %>
      <div class="card mt-3">
        <div class="card-header">
          <h5 class="mb-0">Actions</h5>
        </div>
        <div class="card-body">
          <div class="d-grid gap-2">
            <%= link_to "Activate Version", activate_data_version_path(@data_version),
                method: :patch,
                class: "btn btn-success",
                data: { confirm: "Make this the active version?" } %>

            <% if @data_version.status != 'archived' %>
              <%= link_to "Archive Version", archive_data_version_path(@data_version),
                  method: :patch,
                  class: "btn btn-warning",
                  data: { confirm: "Archive this version?" } %>
            <% end %>

            <%= link_to "Delete Version", data_version_path(@data_version),
                method: :delete,
                class: "btn btn-danger",
                data: { confirm: "Permanently delete this version and all its data?" } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
