<% content_for :title, "Edit #{@data_version.name}" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Edit Data Version</h1>
  <div>
    <%= link_to "View Version", @data_version, class: "btn btn-outline-primary" %>
    <%= link_to "← Back to Versions", data_versions_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-body">
        <%= form_with model: @data_version, local: true do |form| %>
          <% if @data_version.errors.any? %>
            <div class="alert alert-danger">
              <h6><%= pluralize(@data_version.errors.count, "error") %> prohibited this version from being saved:</h6>
              <ul class="mb-0">
                <% @data_version.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= form.label :name, class: "form-label" %>
            <%= form.text_field :name, class: "form-control", placeholder: "e.g., september_2025, q3_2025" %>
            <div class="form-text">
              Choose a descriptive name for this data version. Use lowercase letters, numbers, and underscores.
            </div>
          </div>

          <div class="mb-3">
            <%= form.label :description, class: "form-label" %>
            <%= form.text_area :description, class: "form-control", rows: 3, placeholder: "Describe what this version contains..." %>
            <div class="form-text">
              Optional description to help identify this version later.
            </div>
          </div>

          <div class="mb-3">
            <%= form.label :snapshot_date, "Snapshot Date", class: "form-label" %>
            <%= form.datetime_local_field :snapshot_date, class: "form-control", value: @data_version.snapshot_date&.strftime("%Y-%m-%dT%H:%M") %>
            <div class="form-text">
              The date and time this data version represents.
            </div>
          </div>

          <div class="mb-3">
            <%= form.label :status, class: "form-label" %>
            <%= form.select :status,
                [['Draft', 'draft'], ['Active', 'active'], ['Archived', 'archived']],
                { selected: @data_version.status },
                { class: "form-select" } %>
            <div class="form-text">
              <% if @data_version.is_active? %>
                <strong>Note:</strong> This version is currently active. Changing the status will affect the entire application.
              <% else %>
                Set the status of this version. Only one version can be active at a time.
              <% end %>
            </div>
          </div>

          <div class="d-flex gap-2">
            <%= form.submit "Update Version", class: "btn btn-primary" %>
            <%= link_to "Cancel", @data_version, class: "btn btn-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Current Version Info</h5>
      </div>
      <div class="card-body">
        <dl class="row">
          <dt class="col-sm-5">Status:</dt>
          <dd class="col-sm-7">
            <span class="badge bg-<%= @data_version.status == 'active' ? 'success' : @data_version.status == 'draft' ? 'warning' : 'secondary' %>">
              <%= @data_version.status.capitalize %>
            </span>
            <% if @data_version.is_active? %>
              <span class="badge bg-success ms-1">Active</span>
            <% end %>
          </dd>

          <dt class="col-sm-5">Created:</dt>
          <dd class="col-sm-7"><%= @data_version.created_at.strftime("%m/%d/%Y %I:%M %p") %></dd>

          <dt class="col-sm-5">Last Updated:</dt>
          <dd class="col-sm-7"><%= @data_version.updated_at.strftime("%m/%d/%Y %I:%M %p") %></dd>
        </dl>

        <hr>

        <h6>Data Counts</h6>
        <div class="d-flex justify-content-between mb-1">
          <span>Employees:</span>
          <strong><%= number_with_delimiter(@data_version.employee_count) %></strong>
        </div>
        <div class="d-flex justify-content-between mb-1">
          <span>Squads:</span>
          <strong><%= number_with_delimiter(@data_version.squad_count) %></strong>
        </div>
        <div class="d-flex justify-content-between mb-1">
          <span>Roles:</span>
          <strong><%= number_with_delimiter(@data_version.roles.count) %></strong>
        </div>
      </div>
    </div>

    <% if @data_version.is_active? %>
      <div class="alert alert-warning mt-3">
        <strong>Active Version:</strong> Changes to this version will immediately affect the entire application.
      </div>
    <% end %>
  </div>
</div>
