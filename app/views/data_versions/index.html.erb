<% content_for :title, "Data Version Management" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Data Version Management</h1>
  <%= link_to "← Back to Home", root_path, class: "btn btn-secondary" %>
</div>

<% if @current_version %>
  <div class="alert alert-info mb-4">
    <h5>Current Active Version: <%= @current_version.name %></h5>
    <p class="mb-1"><%= @current_version.description if @current_version.description.present? %></p>
    <small class="text-muted">
      Snapshot Date: <%= @current_version.snapshot_date.strftime("%B %d, %Y at %I:%M %p") %>
    </small>
  </div>
<% else %>
  <div class="alert alert-warning mb-4">
    <strong>No Active Version:</strong> Please activate a version to use the application.
  </div>
<% end %>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">All Data Versions</h5>
    <%= link_to "Create New Version", new_data_version_path, class: "btn btn-primary" %>
  </div>
  <div class="card-body">
    <% if @data_versions.any? %>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Name</th>
              <th>Description</th>
              <th>Status</th>
              <th>Snapshot Date</th>
              <th>Employees</th>
              <th>Roles</th>
              <th>Squads</th>
              <th>Squad Employees</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @data_versions.each do |version| %>
              <tr class="<%= 'table-success' if version.is_active? %>">
                <td>
                  <%= link_to version.name, data_version_path(version), class: "fw-bold text-decoration-none" %>
                  <% if version.is_active? %>
                    <span class="badge bg-success ms-1">Active</span>
                  <% end %>
                </td>
                <td>
                  <small class="text-muted">
                    <%= truncate(version.description, length: 50) if version.description.present? %>
                  </small>
                </td>
                <td>
                  <span class="badge bg-<%= version.status == 'active' ? 'success' : version.status == 'draft' ? 'warning' : 'secondary' %>">
                    <%= version.status.capitalize %>
                  </span>
                </td>
                <td><%= version.snapshot_date.strftime("%m/%d/%Y %I:%M %p") %></td>
                <td><%= number_with_delimiter(version.employee_count) %></td>
                <td><%= number_with_delimiter(version.roles.count) %></td>
                <td><%= number_with_delimiter(version.squad_count) %></td>
                <td><%= number_with_delimiter(version.squads_employees.count) %></td>
                <td>
                  <div class="btn-group" role="group">
                    <%= link_to "View", data_version_path(version), class: "btn btn-sm btn-outline-primary" %>
                    <%= link_to "Edit", edit_data_version_path(version), class: "btn btn-sm btn-outline-secondary" %>
                    <% unless version.is_active? %>
                      <%= link_to "Activate", activate_data_version_path(version),
                          method: :patch,
                          class: "btn btn-sm btn-success",
                          data: { confirm: "Make '#{version.name}' the active version?" } %>
                    <% end %>
                    <% if version.status != 'archived' && !version.is_active? %>
                      <%= link_to "Archive", archive_data_version_path(version),
                          method: :patch,
                          class: "btn btn-sm btn-warning",
                          data: { confirm: "Archive '#{version.name}'?" } %>
                    <% end %>
                    <% unless version.is_active? %>
                      <%= link_to "Delete", data_version_path(version),
                          method: :delete,
                          class: "btn btn-sm btn-danger",
                          data: { confirm: "Permanently delete '#{version.name}' and all its data?" } %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <h5 class="text-muted">No data versions found</h5>
        <p class="text-muted">Create your first data version to get started.</p>
        <%= link_to "Create Version", new_data_version_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
