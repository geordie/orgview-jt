<p style="color: green"><%= notice %></p>

<h1>Squads</h1>

<%= will_paginate_with_bootstrap @squads %>

<div class="row mb-3">
  <div class="col-md-6">
    <%= form_with url: squads_path, method: :get, local: true do %>
      <div class="input-group">
        <%= text_field_tag :search, params[:search], class: "form-control", placeholder: "Search by squad name" %>
        <button class="btn btn-outline-secondary" type="submit">Search</button>
      </div>
    <% end %>
  </div>
</div>

<table class="table table-striped">
  <thead>
    <tr>
      <% common_params = { direction: params[:direction] == "asc" ? "desc" : "asc", depth: params[:depth], parent_id: params[:parent_id] } %>
        <th><%= link_to "Name", squads_path(common_params.merge(sort: "name")) %></th>
        <th style="text-align: center;"><%= link_to "Size", squads_path(common_params.merge(sort: "squad_members")) %></th>
        <th style="text-align: center;"><%= link_to "Managers", squads_path(common_params.merge(sort: "squad_members_managers")) %></th>
        <th style="text-align: center;"><%= link_to "Sub-Teams", squads_path(common_params.merge(sort: "children")) %></th>
        <th style="text-align: center;"><%= link_to "Descendents", squads_path(common_params.merge(sort: "descendents")) %></th>
        <th style="text-align: center;"><%= link_to "Org Size", squads_path(common_params.merge(sort: "org_members")) %></th>
        <th style="text-align: center;"><%= link_to "Org Health", squads_path(common_params.merge(sort: "squad_health")) %></th>
      <th style="text-align: center;">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @squads.each do |squad| %>
      <tr>
        <td data-toggle="tooltip" title="<%= squad.full_path %>">
          <%= link_to squad.name, squads_path(parent_id: squad.id)%></td>
        <td style="text-align: center;"><%= squad.squad_members %></td>
        <td style="text-align: center;"><%= squad.squad_members_managers %></td>
        <td style="text-align: center;"><%= squad.children %></td>
        <td style="text-align: center;"><%= squad.descendents %></td>
        <td style="text-align: center;"><%= squad.org_members %></td>
        <td data-toggle="tooltip" title="<%= squad.squad_health_details %>" style="text-align: center;">
          <% if squad.squad_health == "amber" %>
        <span style="color: orange;">&#x25cf;</span>
          <% elsif squad.squad_health == "red" %>
        <span style="color: red;">&#x25cf;</span>
          <% else %>
        <span style="color: green;">&#x25cf;</span>
          <% end %>
        </td>

        <td style="text-align: center;">
            <div class="btn-group" role="group" style="gap: 8px;">
              <%= link_to 'Detail', squad, class: 'btn btn-primary btn-sm' %>
            </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

