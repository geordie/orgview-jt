<p style="color: green"><%= notice %></p>

<h1>Squads</h1>

<%= will_paginate_with_bootstrap @squads %>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th style="text-align: center;">Size</th>
      <th style="text-align: center;">Managers</th>
      <th style="text-align: center;">Sub-Teams</th>
      <th style="text-align: center;">Descendents</th>
      <th style="text-align: center;">Org Health</th>
      <th style="text-align: center;">Actions</th>
    </tr>
    </tr>
  </thead>
  <tbody>
    <% @squads.each do |squad| %>
      <tr>
        <td data-toggle="tooltip" title="<%= squad.full_path %>"><%= squad.name %></td>
        <td style="text-align: center;"><%= squad.squad_members %></td>
        <td style="text-align: center;"><%= squad.squad_members_managers %></td>
        <td style="text-align: center;"><%= squad.children %></td>
        <td style="text-align: center;"><%= squad.descendents %></td>
        <td data-toggle="tooltip" title="<%= squad.squad_health_details %>" style="text-align: center;">
          <% if squad.squad_health == "amber" %>
        <span style="color: orange;">&#x25cf;</span>
          <% elsif squad.squad_health == "red" %>
        <span style="color: red;">&#x25cf;</span>
          <% else %>
        <span style="color: green;">&#x25cf;</span>
          <% end %>
        </td>
        <td style="text-align: center;">
          <%= link_to 'Show', squad %>
        </td>
      </tr>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="col-auto">
	<%= link_to 'New Squad', new_squad_path, class: 'btn btn-primary' %>
</div>

<div class="col-auto">
  <%= form_with url: squads_build_cba_squads_list_path, method: :post do %>
    <%= submit_tag 'Generate Squads', class: 'btn btn-success' %>
  <% end %>
</div>

<div class="col-auto">
  <%= form_with url: squads_build_squads_stats_path, method: :post do %>
    <%= submit_tag 'Generate Squad Stats', class: 'btn btn-success' %>
  <% end %>
</div>


<div class="col-auto">
  <%= form_with url: squads_destroy_all_path, method: :delete do %>
    <%= submit_tag 'Delete All Squads', class: 'btn btn-danger' %>
  <% end %>
</div>