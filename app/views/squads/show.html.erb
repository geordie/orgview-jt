<h1>Team Overview: <%= @squad.name %></h1>


<div class="row" style="border: 1px solid #ccc; border-radius: 8px; padding: 16px; margin-top: 20px;">
  <h2>Squad Summary</h2>
  <div class="row">
    <div class="col-2"><strong>Parent</strong></div>
    <div class="col-10">
      <% if @squad.parent %>
        <%= link_to @squad.parent.full_path, squad_path(@squad.parent) %>
      <% else %>
        <span>None</span>
      <% end %>
    </div>
  </div>
  <div class="row">
    <div class="col-2"><strong>Team Members</strong></div>
    <div class="col-2"><%= @squad.squads_employees.count %></div>
  </div>
  <div class="row">
    <div class="col-2"><strong>Managers</strong></div>
    <div class="col-2"><%= @squad.squad_members_managers %></div>
  </div>
  <div class="row">
    <div class="col-2"><strong>Sub-Teams</strong></div>
    <div class="col-2"><%= @sub_teams.count %></div>
  </div>
  <div class="row">
    <div class="col-2"><strong>Org Size</strong></div>
    <div class="col-2"><%= @squad.org_members %></div>
  </div>
  <div class="row">
    <div class="col-2"><strong>Depth</strong></div>
    <div class="col-2"><%= @squad.depth %></div>
  </div>
</div>

<% if !@sub_teams.nil? && @sub_teams.count > 0 %>
<div class="row" style="border: 1px solid #ccc; border-radius: 8px; padding: 16px; margin-top: 20px;">
  <h2>Sub-Teams</h2>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Name</th>
        <th>Team Size</th>
        <th>Org Size</th>
      </tr>
    </thead>
    <tbody>
      <% @sub_teams.each do |sub_team| %>
        <tr>
          <td><%= link_to sub_team.name, squad_path(sub_team) %></td>
          <td><%= sub_team.squad_members %></td>
          <td><%= sub_team.org_members %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<% end %>

<div class="row" style="border: 1px solid #ccc; border-radius: 8px; padding: 16px; margin-top: 20px;">
  <h2>Squad Members</h2>
  <table class="table table-striped">
    <thead>
      <tr>
        <th><%= link_to "Name", squad_path(@squad, sort: "employees.name", direction: params[:direction] == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Job Function", squad_path(@squad, sort: "employees.job_sub_family", direction: params[:direction] == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Title", squad_path(@squad, sort: "employees.title", direction: params[:direction] == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Seniority", squad_path(@squad, sort: "employees.seniority", direction: params[:direction] == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Manager ID", squad_path(@squad, sort: "employees.manager_id", direction: params[:direction] == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Country", squad_path(@squad, sort: "employees.country", direction: params[:direction] == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Worker Type", squad_path(@squad, sort: "employees.worker_type", direction: params[:direction] == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Start Date", squad_path(@squad, sort: "employees.start_date", direction: params[:direction] == "asc" ? "desc" : "asc") %></th>
      </tr>
    </thead>
    <tbody>
      <% @squad_members.each do |member| %>
        <tr>
          <td><%= member.employee.name %></td>
          <td><%= member.employee.job_function %></td>
          <td><%= member.employee.title %></td>
          <td><%= member.employee.seniority %></td>
          <td><%= member.employee.manager_id %></td>
          <td><%= member.employee.country %></td>
          <td><%= member.employee.worker_type %></td>
          <td><%= member.employee.start_date %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
