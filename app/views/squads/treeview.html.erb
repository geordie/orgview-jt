
<script type="module">
import * as primitives from 'primitives';

var control;
var items = [];

document.addEventListener('DOMContentLoaded', function () {

	var options = new primitives.OrgConfig();

	<% @squads.each do |squad| %>
		var itemTitleColor = primitives.Colors.Green;
		<% if squad.squad_health == "red" %>
			itemTitleColor = primitives.Colors.Red;
		<% elsif squad.squad_health == "amber" %>
			itemTitleColor = primitives.Colors.Orange;
		<% end %>
		items.push(new primitives.OrgItemConfig({
			id: <%= squad.id %>,
			parent: <%= squad.parent_id || "null" %>,
			title: "<%= squad.name %>",
			org_members: <%= squad.org_members %>,
			squad_members: <%= squad.squad_members %>,
			squad_members_managers: <%= squad.squad_members_managers %>,
			squad_health: "<%= squad.squad_health %>",
			squad_health_details: "<%= squad.squad_health_details %>",
			children: <%= squad.children %>,
			descendents: <%= squad.descendents %>,
			itemTitleColor: itemTitleColor
		}));
		<% if squad.sub_teams.count > 0 %>
			getSubTeams(<%= squad.id %>);
		<% end %>
	<% end %>

	options.items = items;
	options.cursorItem = 0;
	options.templates = [getSquadTemplate()];
	options.defaultTemplateName = "squadTemplate";
	options.onItemRender = onTemplateRender;
	options.normalItemsInterval = 10;
	options.normalLevelShift = 44;
	options.padding = { left: 10, top: 20, right: 10, bottom: 10};
	options.hasSelectorCheckbox = primitives.Enabled.False;
	// options.onCursorChanging = function (e, data) {};
	options.onCursorChanged = onNodeHighlighted;

	control = primitives.OrgDiagram(document.getElementById("basicdiagram"), options);
});

function onNodeHighlighted(event, data) {
	document.getElementById("sidecontainer").innerHTML = data.context.title;
	var squadMembers = getSquadMembers(data.context.id)
		.then( response => {
			tableCreate(response);
		}
	);
}

function tableCreate(squadMembers) {
	const sideContainer = document.getElementById("sidecontainer");
	var tbl = document.createElement('table');
	tbl.style.width = '498px';
	tbl.style.border = '1px solid black';

	squadMembers.forEach(squadMember => {
		const tr = tbl.insertRow();
		const td0 = tr.insertCell();
		const td1 = tr.insertCell();
		const td2 = tr.insertCell();
		const td3 = tr.insertCell();
		td0.appendChild(document.createTextNode(squadMember.employee.id));
		td1.appendChild(document.createTextNode(squadMember.employee.name));
		td2.appendChild(document.createTextNode(squadMember.employee.title));
		td3.appendChild(document.createTextNode(squadMember.employee.manager_id));

		Array.from(tr.cells).forEach(cell => {
			cell.style.border = '1px solid black';
			cell.style.padding = '3px';});
	});

	sideContainer.appendChild(tbl);
}

function onTemplateRender(event, data) {
	switch (data.renderingMode) {
		case primitives.RenderingMode.Create:
			/* Initialize template content here */
			break;
		case primitives.RenderingMode.Update:
			/* Update template content here */
			break;
	}

	var itemConfig = data.context;

	if (data.templateName == "squadTemplate") {
		var element = data.element;

		element.firstChild.style.backgroundColor = itemConfig.itemTitleColor || primitives.Colors.RoyalBlue;
		element.firstChild.firstChild.textContent = itemConfig.title;

		element.childNodes[1].innerHTML = '<strong>ID:</strong> ' + itemConfig.id;
		element.childNodes[2].innerHTML = '<strong>Org Size:</strong> ' + itemConfig.org_members;
		element.childNodes[3].innerHTML = '<strong>Team Size:</strong> ' + itemConfig.squad_members;
		element.childNodes[4].innerHTML = '<strong>Managers:</strong> ' + itemConfig.squad_members_managers;
		element.childNodes[5].innerHTML = '<strong>Sub-Teams:</strong> ' + itemConfig.children;
		element.childNodes[6].innerHTML = '<strong>Descendents:</strong> ' + itemConfig.descendents;
		element.childNodes[7].innerHTML = '<strong>Squad Health:</strong> ';
		element.childNodes[8].innerHTML = itemConfig.squad_health_details;
	}
}

function getSquadMembers(squadId) {
	// Make a GET request to fetch data for the selected squad
	return fetch(`/squads/${squadId}/squad_members.json`, {
		method: 'GET'
	})
	.then(response => response.json())
	.then(data => {
		return data;
	})
	.catch(error => {
		console.error('Error:', error);
	});
}


function getSubTeams(parentId) {
	// Make a GET request to fetch data for the selected squad
	fetch(`/squads/${parentId}/sub_teams.json`, {
		method: 'GET'
	})
	.then(response => response.json())
	.then(data => {
		var newItems = [];
		// Add child nodes to the clicked node based on data
		data.forEach(sub_team => {
			if (!items.some(item => item.id === sub_team.sub_team.id)) {

				var itemTitleColor = primitives.Colors.Green;

				if ( sub_team.sub_team.squad_health == "red" )
					itemTitleColor = primitives.Colors.Red;
				else if ( sub_team.sub_team.squad_health == "amber" )
					itemTitleColor = primitives.Colors.Orange;

				items.push(new primitives.OrgItemConfig({
					id: sub_team.sub_team.id,
					parent: parentId,
					title: sub_team.sub_team.name,
					org_members: sub_team.sub_team.org_members,
					squad_members: sub_team.sub_team.squad_members,
					squad_members_managers: sub_team.sub_team.squad_members_managers,
					squad_health: sub_team.sub_team.squad_health,
					squad_health_details: sub_team.sub_team.squad_health_details,
					children: sub_team.sub_team.children,
					descendents: sub_team.sub_team.descendents,
					image: "/images/photos/a.png",
					itemTitleColor: itemTitleColor
				}));
				if(sub_team.sub_team_count > 0) {
					getSubTeams(sub_team.sub_team.id);
				}
			}
		});
		control.setOptions = {items: items};
		control.update(primitives.UpdateMode.Refresh);
		
	})
	.catch(error => {
		console.error('Error:', error);
	});
}

function getSquadTemplate() {
