	result.itemTemplate = ["div",
		{
			"style": {
				width: result.itemSize.width + "px",
				height: result.itemSize.height + "px"
			},
			"class": ["bp-item", "bp-corner-all", "bt-item-frame"]
		},
		["div",
			{
				name: "titleBackground",
				style: {
					top: "2px",
					left: "2px",
					width: "238px",
					height: "20px",
					overflow: "hidden"
				},
				"class": ["bp-item", "bp-corner-all", "bp-title-frame"]
			},
			["div",
				{
					name: "title",
					style: {
						top: "2px",
						left: "2px",
						width: "228px",
						height: "18px",
						fontSize: "12px",
						overflow: "hidden"
					},
					"class": ["bp-item", "bp-title"]
				}
			]
		],
		["div",
			{
				name: "squad_id",
				style: {
					top: "30px",
					left: "10px",
					width: "162px",
					height: "36px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "org_members",
				style: {
					top: "30px",
					left: "110px",
					width: "162px",
					height: "36px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "team_members",
				style: {
					top: "50px",
					left: "10px",
					width: "162px",
					height: "36px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "managers",
				style: {
					top: "70px",
					left: "10px",
					width: "162px",
					height: "36px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "children",
				style: {
					top: "50px",
					left: "110px",
					width: "162px",
					height: "36px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "descendents",
				style: {
					top: "70px",
					left: "110px",
					width: "162px",
					height: "36px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "health-heading",
				style: {
					top: "90px",
					left: "10px",
					width: "200px",
					height: "24px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "health-details",
				style: {
					top: "110px",
					left: "10px",
					width: "200px",
					height: "52px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "label",
				style: {
					top: "-20px",
					left: "3px",
					width: "208px",
					height: "20px",
					fontSize: "14px",
					textAlign: "center",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		]
	];

	return result;
}

</script>

<div style="width: 100%">
  <div class="d-flex">
    <div class="content-md" id="basicdiagram" style="width: 80%; height: 800px; border-style: dotted; border-width: 1px; margin: 10px;"></div>
    <div class="content-md" id="sidecontainer" style="width: 20%; height: 800px; border-style: dotted; border-width: 1px; margin: 10px;"></div>
  </div>
</div>