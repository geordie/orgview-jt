
<script type="module">
import * as primitives from 'primitives';

var control;
var items = [];

document.addEventListener('DOMContentLoaded', function () {

	var options = new primitives.OrgConfig();

	<% @squads.each do |squad| %>
		var itemTitleColor = primitives.Colors.Red;
		<% if squad.sub_teams.count > 0 %>
			itemTitleColor = primitives.Colors.Green;
		<% end %>
		items.push(new primitives.OrgItemConfig({
			id: <%= squad.id %>,
			parent: <%= squad.parent_id || "null" %>,
			title: "<%= squad.name %>",
			squad_members: <%= squad.squad_members %>,
			children: <%= squad.children %>,
			descendents: <%= squad.descendents %>,
			itemTitleColor: itemTitleColor
		}));
		<% if squad.sub_teams.count > 0 %>
			getSubTeams(<%= squad.id %>);
		<% end %>
	<% end %>

	options.items = items;
	options.cursorItem = 0;
	options.templates = [getSquadTemplate()];
	options.defaultTemplateName = "squadTemplate";
	options.onItemRender = onTemplateRender;
	options.normalItemsInterval = 10;
	options.normalLevelShift = 44;
	options.padding = { left: 10, top: 20, right: 10, bottom: 10};
	options.hasSelectorCheckbox = primitives.Enabled.False;
	options.onCursorChanging = function (e, data) {

		if (data.context !== null) {
			// Get the sub_teams of the selected squad
			getSubTeams(data.context.id);
		}
	};

	control = primitives.OrgDiagram(document.getElementById("basicdiagram"), options);
});

function onTemplateRender(event, data) {
	switch (data.renderingMode) {
		case primitives.RenderingMode.Create:
			/* Initialize template content here */
			break;
		case primitives.RenderingMode.Update:
			/* Update template content here */
			break;
	}

	var itemConfig = data.context;

	if (data.templateName == "squadTemplate") {
		var element = data.element;

		element.firstChild.style.backgroundColor = itemConfig.itemTitleColor || primitives.Colors.RoyalBlue;
		element.firstChild.firstChild.textContent = itemConfig.title;

		element.childNodes[1].innerHTML = '<strong>Members:</strong> ' + itemConfig.squad_members;
		element.childNodes[2].innerHTML = '<strong>Children:</strong> ' + itemConfig.children;
		element.childNodes[3].innerHTML = '<strong>Descendents:</strong> ' + itemConfig.descendents;
	}
}

function getSubTeams(parentId) {
	// Make a GET request to fetch data for the selected squad
	fetch(`/squads/${parentId}/sub_teams.json`, {
		method: 'GET'
	})
	.then(response => response.json())
	.then(data => {
		var newItems = [];
		// Add child nodes to the clicked node based on data
		data.forEach(sub_team => {
			if (!items.some(item => item.id === sub_team.sub_team.id)) {
				var itemTitleColor = primitives.Colors.Red;
				if(sub_team.sub_team_count > 0) {
					itemTitleColor = primitives.Colors.Green;
				}
				items.push(new primitives.OrgItemConfig({
					id: sub_team.sub_team.id,
					parent: parentId,
					title: sub_team.sub_team.name,
					squad_members: sub_team.sub_team.squad_members,
					children: sub_team.sub_team.children,
					descendents: sub_team.sub_team.descendents,
					image: "/images/photos/a.png",
					itemTitleColor: itemTitleColor
				}));
				if(sub_team.sub_team_count > 0) {
					getSubTeams(sub_team.sub_team.id);
				}
			}
		});
		control.setOptions = {items: items};
		control.update(primitives.UpdateMode.Refresh);
		
	})
	.catch(error => {
		console.error('Error:', error);
	});
}

function getSquadTemplate() {
	var result = new primitives.TemplateConfig();
	result.name = "squadTemplate";

	result.itemSize = new primitives.Size(240, 120);
	result.minimizedItemSize = new primitives.Size(12, 12);

	result.itemTemplate = ["div",
		{
			"style": {
				width: result.itemSize.width + "px",
				height: result.itemSize.height + "px"
			},
			"class": ["bp-item", "bp-corner-all", "bt-item-frame"]
		},
		["div",
			{
				name: "titleBackground",
				style: {
					top: "2px",
					left: "2px",
					width: "238px",
					height: "20px",
					overflow: "hidden"
				},
				"class": ["bp-item", "bp-corner-all", "bp-title-frame"]
			},
			["div",
				{
					name: "title",
					style: {
						top: "2px",
						left: "2px",
						width: "228px",
						height: "18px",
						fontSize: "14px",
						overflow: "hidden"
					},
					"class": ["bp-item", "bp-title"]
				}
			]
		],
		["div",
			{
				name: "squad_size",
				style: {
					top: "31px",
					left: "10px",
					width: "162px",
					height: "36px",
					fontSize: "10px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "children",
				style: {
					top: "52px",
					left: "10px",
					width: "162px",
					height: "36px",
					fontSize: "10px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "descendents",
				style: {
					top: "73px",
					left: "10px",
					width: "162px",
					height: "36px",
					fontSize: "10px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "label",
				style: {
					top: "-20px",
					left: "3px",
					width: "208px",
					height: "20px",
					fontSize: "14px",
					textAlign: "center",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		]
	];

	return result;
}

</script>

<div class="container-md">
    <div class="d-flex justify-content-center">
        <div class="content-md" id="basicdiagram" style="width: 1200px; height: 800px; border-style: dotted; border-width: 1px;"></div>
    </div>
</div>