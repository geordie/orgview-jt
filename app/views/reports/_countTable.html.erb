<div class="container-md">
	<div class="row justify-content-center">
		<table class="table table-striped">
			<thead>
				<tr>
					<th scope="col" class="text-left border"> <%= labelheader %> </th>
					<th scope="col" class="text-center border"> Count </th>
					<th scope="col" class="text-center border"> Percentage </th>
					<% if local_assigns[:ratios] %>
						<th scope="col" class="text-center border"> Ratio </th>
					<% end %>
				</tr>
			</thead>
			<tbody>
				<% labels.each_with_index do |label, index| %>
				<tr>
					<td class="text-left border">
						<% if local_assigns[:label_link_controller] && local_assigns[:label_link_param_name] %>
							<%= link_to label, url_for(controller: label_link_controller, action: 'index', label_link_param_name => label) %>
						<% else %>
							<%= label %>
						<% end %>
					</td>
					<td class="text-center border">
						<% if local_assigns[:count_link_controller] && local_assigns[:count_link_action] && local_assigns[:count_link_param_name] %>
							<%= link_to counts[index], url_for(controller: count_link_controller, action: count_link_action, count_link_param_name => label) %>
						<% else %>
							<%= counts[index] %>
						<% end %>
					</td>

					<td class="text-center border"> <%= percentages[index].round(1) %>% </td>
					<% if local_assigns[:ratios] %>
						<td class="text-center border"> <%= ratios[index].round(1) %> </td>
					<% end %>
				</tr>
				<% end %>
				<tr>
					<td class="text-left border"> <strong> Total </strong> </td>
					<td class="text-center border"> <strong> <%= counts.sum %> </strong> </td>
					<td class="text-center border"> <strong> 100% </strong> </td>
				</tr>
			</tbody>
		</table>
	</div>
</div>
