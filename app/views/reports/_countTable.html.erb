<div class="container-md">
	<div class="row justify-content-center">
		<table class="table table-striped">
			<thead>
				<tr>
					<th scope="col" class="text-left border"> <%= labelheader %> </th>
					<th scope="col" class="text-center border"> Count </th>
					<th scope="col" class="text-center border"> Percentage </th>
				</tr>
			</thead>
			<tbody>
				<% labels.each_with_index do |label, index| %>
				<tr>
					<td class="text-left border"> <%= label %> </td>
					<td class="text-center border"> <%= counts[index] %> </td>
					<td class="text-center border"> <%= percentages[index].round(1) %>% </td>
				</tr>
				<% end %>
				<tr>
					<td class="text-left border"> <strong> Total </strong> </td>
					<td class="text-center border"> <strong> <%= counts.sum %> </strong> </td>
					<td class="text-center border"> <strong> 100% </strong> </td>
				</tr>
			</tbody>
		</table>
	</div>
</div>
