<h1>Employee Worker Types</h1>

<%= render partial: 'countTable',
	locals: {
		labelheader: 'Worker Type',
		labels: @worker_types,
		counts: @counts,
		percentages: @percentages
		} %>

<%= render partial: 'horizontalBarChart',
	locals: {
		id: 'rolesChart',
		labels: @worker_types,
		data: @counts,
		percentages: @percentages,
		xlabel: '# of People'
	} %>

