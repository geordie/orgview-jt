<h1>Team Geography Report</h1>

<%= render partial: 'countTable',
	locals: { labelheader: 'Squad Size',
		labels: @team_geos,
		counts: @counts,
		percentages: @percentages
	} %>

<%= render partial: 'horizontalBarChart',
	locals: { id: 'rolesChart',
		labels: @team_geos,
		data: @counts,
		percentages: @percentages,
		xlabel: '# of Squads'
	} %>

