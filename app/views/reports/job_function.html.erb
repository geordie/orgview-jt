<h1>Job Function Report</h1>

<%= render partial: 'countTable',
	locals: { labelheader: 'Job Function',
			  labels: @job_functions,
			  label_link_controller: "roles",
			  label_link_param_name: "job_function",
			  counts: @counts,
			  count_link_controller: "reports",
			  count_link_action: "roles",
			  count_link_param_name: "job_function",
			  percentages: @percentages } %>

<%= render partial: 'horizontalBarChart', locals: { id: 'rolesChart', labels: @job_functions, data: @counts, percentages: @percentages, xlabel: '# of Employees' } %>

