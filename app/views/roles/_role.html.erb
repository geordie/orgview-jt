<div id="<%= dom_id role %>">
	<div class="row px-4">
		<div class="col-md-3">
			<h3>Role Details:</h3>

			<table class="table">
				<tbody>
					<tr>
						<td class="bg-light"><strong>ID</strong></td>
						<td><%= @role.id %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Job Function</strong></td>
						<td><%= @role.job_function %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Role</strong></td>
						<td><%= @role.role %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Seniority</strong></td>
						<td><%= @role.seniority %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Is Manager</strong></td>
						<td><%= @role.is_manager ? 'Yes' : 'No' %></td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</div>