<p style="color: green"><%= notice %></p>

<h1>Roles</h1>

<div id="roles">
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Job Function</th>
        <th>Role</th>
        <th>Seniority</th>
        <th>Is Manager?</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @roles.each do |role| %>
        <tr>
          <td><%= role.job_function %></td>
          <td><%= role.role %></td>
          <td><%= role.seniority %></td>
          <td><%= role.is_manager ? 'Yes' : 'No' %></td>
          <td>
            <%= link_to 'Show', role_path(role), class: 'btn btn-primary' %>
            <%= link_to 'Edit', edit_role_path(role), class: 'btn btn-warning' %>
            <%= link_to 'Delete', role_path(role), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to "New role", new_role_path %>
