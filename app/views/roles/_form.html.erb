<%= form_with(model: @role, local: true) do |form| %>
  <div class="form-group">
    <%= form.label :job_function %>
    <%= form.text_field :job_function, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :role %>
    <%= form.text_field :role, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :seniority %>
    <%= form.number_field :seniority, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :is_manager %>
    <%= form.select :is_manager, [[ 'Yes', true ], [ 'No', false ]], {}, class: 'form-control' %>
  </div>

  <%= form.submit 'Save', class: 'btn btn-primary' %>
<% end %>
