
<div id="<%= dom_id role %>">

  <%= form_with(model: @role, local: true) do |form| %>
    <div class="row px-4">
      <div class="col-md-3">
        <h3>Edit Role:</h3>

        <table class="table">
          <tbody>
            <tr>
              <td class="bg-light"><strong>Job Function</strong></td>
              <td><%= form.text_field :job_function, class: 'form-control' %></td>
            </tr>
            <tr>
              <td class="bg-light"><strong>Role</strong></td>
              <td><%= form.text_field :role, class: 'form-control' %></td>
            </tr>
            <tr>
              <td class="bg-light"><strong>Seniority</strong></td>
              <td><%= form.number_field :seniority, class: 'form-control' %></td>
            </tr>
            <tr>
              <td class="bg-light"><strong>Is Manager</strong></td>
              <td><%= form.select :is_manager, [[ 'Yes', true ], [ 'No', false ]], {}, class: 'form-control' %></td>
            </tr>
          </tbody>
        </table>

        <table class="table table-borderless">
          <thead>
            <tr>
              <td>
                <%= link_to 'Save', '#', class: 'btn btn-primary', id: 'submit-form' %>
                <% if !@role.id.nil? %>
                  <%= link_to 'Delete', role_path(@role), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger' %>
                <% end %>
                <%= link_to "Back to roles", roles_path, class: 'btn btn-secondary' %>
              </td>
            </tr>
          </thead>
        </table>
      </div>
    </div>
  <% end %>

</div>

<script>
  document.getElementById('submit-form').addEventListener('click', function(e) {
    e.preventDefault();
    document.querySelector('form').submit();
  });
</script>