<% content_for :head do %>
  <%= javascript_import_module_tag "bootstrap" %>
<% end %>

<script>
document.addEventListener('DOMContentLoaded', function() {
	document.querySelectorAll('.accordion-button').forEach(button => {
		button.addEventListener('click', function () {
			var url = this.dataset.url;
			var target = document.querySelector(this.dataset.bsTarget);
			if (target.innerHTML.trim() === '' || !target.firstChild.innerHTML) {
				fetch(url)
					.then(response => response.text())
					.then(html => {
						target.innerHTML = html;
						target.querySelectorAll('.accordion-button').forEach(button => {
							button.addEventListener('click', expand)
						});
					})
			}

			updateIcon(button);
		});
	});
});

document.querySelectorAll('.accordion-button').forEach(button => {
  button.addEventListener('click', () => {
    let icon = button.querySelector('.bi-chevron-down') || button.querySelector('.bi-chevron-right');
    if (icon) {
      if (icon.classList.contains('bi-chevron-down')) {
        icon.classList.remove('bi-chevron-down');
        icon.classList.add('bi-chevron-right');
      } else {
        console.log("Haves ICON", icon.classList);
        icon.classList.remove('bi-chevron-right');
        icon.classList.add('bi-chevron-down');
      }
    }
  });
});

function expand(element) {
	var url = this.dataset.url;
	var target = document.querySelector(this.dataset.bsTarget);
	if (target.innerHTML.trim() === '' || !target.firstChild.innerHTML) {
		fetch(url)
			.then(response => response.text())
			.then(html => {
				target.innerHTML = html;
				target.querySelectorAll('.accordion-button').forEach(button => {
					if( button.dataset.directsCount && button.dataset.directsCount > 0){
						button.addEventListener('click', expand)
					}
				});
			})
	}

	updateIcon(this);
}

function updateIcon(element){
	let icon = element.querySelector('.bi-chevron-down') || element.querySelector('.bi-chevron-right');
	if (icon) {
		if (icon.classList.contains('bi-chevron-down')) {
			icon.classList.remove('bi-chevron-down');
			icon.classList.add('bi-chevron-right');
		}
		else {
			icon.classList.remove('bi-chevron-right');
			icon.classList.add('bi-chevron-down');
		}
	}
}
</script>


<div id="org-structure">
	<div class="container-md accordion">
		<%= render partial: 'structure', locals: { employees: @employees } %>
	</div>
</div>
