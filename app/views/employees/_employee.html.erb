<div id="<%= dom_id employee %>">
	<div class="row px-4">
		<div class="col-md-6">
			<h3>Employee Details:</h3>

			<table class="table">
				<tbody>
					<tr>
						<td class="bg-light"><strong>Person ID</strong></td>
						<td><%= @employee.person_id %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Name</strong></td>
						<td>
							<span class="emp-name-display"
								data-employee-id="<%= @employee.id %>"
								data-original="<%= @employee.name.to_s %>">
								<%= @employee.name.presence || '<span class="text-muted small">—</span>'.html_safe %>
							</span>
						</td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Title</strong></td>
						<td><%= @employee.title %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Job Code</strong></td>
						<td><%= @employee.job_code %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Job Level</strong></td>
						<td><%= @employee.job_level %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Seniority</strong></td>
						<td><%= @employee.seniority %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Country</strong></td>
						<td><%= @employee.country %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Personnel Area</strong></td>
						<td><%= @employee.personnel_area %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Company</strong></td>
						<td><%= @employee.company %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Manager</strong></td>
						<td><%= @employee.manager ? link_to(@employee.manager.person_id, @employee.manager) : "None" %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Is Manager</strong></td>
						<td><%= @employee.is_manager ? 'Yes' : 'No' %></td>
					</tr>
				</tbody>
			</table>
		</div>

		<div class="col-md-6">
			<h3>Direct Reports:</h3>
			<% if @employee.direct_reports.any? %>
				<table class="table">
					<thead>
						<tr>
							<th>Person ID</th>
							<th>Title</th>
							<th>Name</th>
							<th>Job Code</th>
							<th>Personnel Area</th>
						</tr>
					</thead>
					<tbody>
						<% @employee.direct_reports.each do |report| %>
							<tr>
								<td><%= link_to report.person_id, report %></td>
								<td><%= report.title %></td>
								<td><%= report.name.presence || '—' %></td>
								<td><%= report.job_code %></td>
								<td><%= report.personnel_area %></td>
							</tr>
						<% end %>
					</tbody>
				</table>
				<p class="text-muted">Total: <%= @employee.direct_reports.count %> direct reports</p>
			<% else %>
				<p class="text-muted">No direct reports</p>
			<% end %>

			<% if @employee.teams.any? %>
				<h3>Team Memberships:</h3>
				<ul class="list-group">
					<% @employee.teams.each do |team| %>
						<li class="list-group-item">
							<% if team.pretty_name.present? %>
								<strong><%= link_to team.pretty_name, team %></strong>
								<br><small class="text-muted">(<%= team.name %>)</small>
							<% else %>
								<strong><%= link_to team.full_path, team %></strong>
							<% end %>
						</li>
					<% end %>
				</ul>
			<% end %>
		</div>
	</div>
</div>
