<p style="color: green"><%= notice %></p>

<h1>Employees</h1>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Title</th>
      <th>Job Function</th>
      <th>Seniority</th>
      <th>Is Manager</th>
      <th>Start Date</th>
      <th>Manager</th>
      <th>Direct Reports</th>
    <th>Show Details</th>
    </tr>
  </thead>
  <tbody>
    <% @employees.each do |employee| %>
      <tr>
        <td><%= employee.name %></td>
        <td><%= employee.title %></td>
        <td><%= employee.job_function %></td>
        <td><%= employee.seniority %></td>
        <td><%= employee.is_manager ? "Yes" : "" %></td>
        <td><%= employee.start_date %></td>
        <td><%= employee.manager.try(:name) %></td>
        <td><%= employee.direct_reports.count %></td>
    <td><%= link_to "Show this employee", employee %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= form_with url: new_employee_path, method: :get do %>
  <%= submit_tag 'New employee' %>
<% end %>

<%= form_with url: employees_create_samples_path, method: :post do %>
  <%= submit_tag 'Generate Employees' %>
<% end %>

<%= form_with url: employees_destroy_all_path, method: :delete do %>
  <%= submit_tag 'Delete All Employees' %>
<% end %>