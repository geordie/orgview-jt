<p style="color: green"><%= notice %></p>

<h1>Employees</h1>

<%= will_paginate_with_bootstrap @employees %>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Title</th>
      <th>Job Function</th>
      <th>Seniority</th>
      <th>Is Manager</th>
      <th>Start Date</th>
      <th>Manager</th>
      <th>Direct Reports</th>
    <th>Show Details</th>
    </tr>
  </thead>
  <tbody>
    <% @employees.each do |employee| %>
      <tr>
        <td><%= employee.name %></td>
        <td><%= employee.title %></td>
        <td><%= employee.job_function %></td>
        <td><%= employee.seniority %></td>
        <td><%= employee.is_manager ? "Yes" : "" %></td>
        <td><%= employee.start_date %></td>
        <td><%= employee.manager.try(:name) %></td>
        <td><%= employee.direct_reports.count %></td>
    <td><%= link_to "Show this employee", employee %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="row justify-content-center">
  <div class="col-auto">
    <%= form_with url: new_employee_path, method: :get do %>
      <%= submit_tag 'New employee', class: 'btn btn-primary' %>
    <% end %>
  </div>

  <div class="col-auto">
    <%= form_with url: employees_build_cba_list_path, method: :post do %>
      <%= submit_tag 'Generate Employees', class: 'btn btn-success' %>
    <% end %>
  </div>

  <div class="col-auto">
    <%= form_with url: employees_destroy_all_path, method: :delete do %>
      <%= submit_tag 'Delete All Employees', class: 'btn btn-danger' %>
    <% end %>
  </div>
</div>