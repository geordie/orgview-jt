<p style="color: green"><%= notice %></p>

<h1>Employees</h1>

<%= will_paginate_with_bootstrap @employees %>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Title</th>
      <th>Job Function</th>
      <th>Seniority</th>
      <th>Manager</th>
      <th>Direct Reports</th>
    </tr>
  </thead>
  <tbody>
    <% @employees.each do |employee| %>
      <tr>
        <td><%= link_to employee.name, employee %></td>
        <td><%= employee.title %></td>
        <td><%= employee.job_function %></td>
        <td><%= employee.seniority %></td>
        <td><%= employee.manager ? link_to(employee.manager.name, employee.manager) : "" %></td>
        <td><%= employee.direct_reports.count %></td>
      </tr>
    <% end %>
  </tbody>
</table>
