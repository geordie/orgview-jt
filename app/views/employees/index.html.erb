<p style="color: green"><%= notice %></p>

<h1>Employees</h1>

<%= will_paginate_with_bootstrap @employees %>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Person ID</th>
      <th>Name</th>
      <th>Title</th>
      <th>Job Code</th>
      <th>Seniority</th>
      <th>Manager</th>
      <th>Team</th>
      <th>Team Size</th>
      <th>Org Size</th>
      <th>Direct Reports</th>
    </tr>
  </thead>
  <tbody>
    <% @employees.each do |employee| %>
      <tr>
        <td><%= link_to employee.person_id, employee %></td>
        <td>
          <span class="emp-name-display"
                data-employee-id="<%= employee.id %>"
                data-original="<%= employee.name.to_s %>">
            <%= employee.name.presence || '<span class="text-muted small">—</span>'.html_safe %>
          </span>
        </td>
        <td><%= employee.title %></td>
        <td><%= employee.job_code %></td>
        <td><%= employee.seniority %></td>
        <td><%= employee.manager ? link_to(employee.manager.person_id, employee.manager) : "" %></td>
        <td><%= employee.teams.first&.pretty_name.presence %></td>
        <td><%= employee.teams.first&.member_count&.then { |n| n > 0 ? n : nil } %></td>
        <td><%= employee.teams.first&.org_member_count&.then { |n| n > 0 ? n : nil } %></td>
        <td><%= employee.direct_reports.count %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<script>
(function () {
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

  function startEdit(span) {
    const original = span.dataset.original;
    const input = document.createElement('input');
    input.type = 'text';
    input.value = original;
    input.className = 'form-control form-control-sm';
    input.style.width = '160px';
    span.replaceWith(input);
    input.focus();
    input.select();

    function save() {
      const value = input.value.trim();
      const employeeId = span.dataset.employeeId;
      fetch(`/employees/${employeeId}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
          'Accept': 'application/json'
        },
        body: JSON.stringify({ employee: { name: value } })
      })
      .then(r => r.ok ? r.json() : Promise.reject(r))
      .then(() => {
        span.dataset.original = value;
        if (value) {
          span.textContent = value;
        } else {
          span.innerHTML = '<span class="text-muted small">—</span>';
        }
        input.replaceWith(span);
      })
      .catch(() => {
        alert('Failed to save. Please try again.');
        input.replaceWith(span);
      });
    }

    function cancel() {
      input.replaceWith(span);
    }

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); save(); }
      if (e.key === 'Escape') { cancel(); }
    });
    input.addEventListener('blur', save);
  }

  document.addEventListener('click', function (e) {
    const span = e.target.closest('span.emp-name-display');
    if (span) startEdit(span);
  });
})();
</script>
