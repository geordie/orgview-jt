<%= form_with(model: @employee, local: true) do |form| %>
	<div class="row px-4">
		<div class="col-md-3">
			<h3>Employee Details:</h3>

			<table class="table">
				<tbody>
					<tr>
						<td class="bg-light"><strong>Person ID</strong></td>
						<td><%= form.text_field :person_id, class: 'form-control' %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Title</strong></td>
						<td><%= form.text_field :title, class: 'form-control' %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Job Code</strong></td>
						<td><%= form.text_field :job_code, class: 'form-control' %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Job Level</strong></td>
						<td><%= form.text_field :job_level, class: 'form-control' %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Seniority</strong></td>
						<td><%= form.number_field :seniority, class: 'form-control' %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Country</strong></td>
						<td><%= form.text_field :country, class: 'form-control' %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Personnel Area</strong></td>
						<td><%= form.text_field :personnel_area, class: 'form-control' %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Company</strong></td>
						<td><%= form.text_field :company, class: 'form-control' %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Manager ID</strong></td>
						<td><%= form.text_field :manager_id, class: 'form-control', placeholder: 'Person ID of manager' %></td>
					</tr>
					<tr>
						<td class="bg-light"><strong>Is Manager</strong></td>
						<td><%= form.select :is_manager, [[ 'Yes', true ], [ 'No', false ]], {}, class: 'form-control' %></td>
					</tr>
				</tbody>
			</table>

			<table class="table table-borderless">
				<thead>
					<tr>
						<td>
							<%= link_to 'Save', '#', class: 'btn btn-primary', id: 'submit-form' %>
							<% if !@employee.id.nil? %>
								<%= link_to 'Delete', employee_path(@employee), data: { method: :delete, confirm: 'Are you sure?' }, class: 'btn btn-danger' %>
							<% end %>
							<%= link_to "Back to employees", employees_path, class: 'btn btn-secondary' %>
						</td>
					</tr>
				</thead>
			</table>
		</div>
	</div>
<% end %>

<script>
	document.getElementById('submit-form').addEventListener('click', function(e) {
		e.preventDefault();
		document.querySelector('form').submit();
	});
</script>
