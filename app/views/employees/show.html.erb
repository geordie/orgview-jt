<p style="color: green"><%= notice %></p>

<%= render @employee %>

<div class="row px-4">
  <table class="table table-borderless">
      <thead>
        <tr>
          <td>
              <%= link_to 'Edit', edit_employee_path(@employee), class: 'btn btn-warning' %>
              <%= link_to 'Delete', employee_path(@employee), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger' %>
              <%= link_to "Back to employees", employees_path, class: 'btn btn-secondary' %>
          </td>
        </tr>
      </thead>
  </table>
</div>
