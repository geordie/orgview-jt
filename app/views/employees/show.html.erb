<p style="color: green"><%= notice %></p>

<%= render @employee %>

<script>
(function () {
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

  function startEdit(span) {
    const original = span.dataset.original;
    const input = document.createElement('input');
    input.type = 'text';
    input.value = original;
    input.className = 'form-control form-control-sm';
    input.style.width = '220px';
    span.replaceWith(input);
    input.focus();
    input.select();

    function save() {
      const value = input.value.trim();
      const employeeId = span.dataset.employeeId;
      fetch(`/employees/${employeeId}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
          'Accept': 'application/json'
        },
        body: JSON.stringify({ employee: { name: value } })
      })
      .then(r => r.ok ? r.json() : Promise.reject(r))
      .then(() => {
        span.dataset.original = value;
        if (value) {
          span.textContent = value;
        } else {
          span.innerHTML = '<span class="text-muted small">—</span>';
        }
        input.replaceWith(span);
      })
      .catch(() => {
        alert('Failed to save. Please try again.');
        input.replaceWith(span);
      });
    }

    function cancel() {
      input.replaceWith(span);
    }

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); save(); }
      if (e.key === 'Escape') { cancel(); }
    });
    input.addEventListener('blur', save);
  }

  document.addEventListener('click', function (e) {
    const span = e.target.closest('span.emp-name-display');
    if (span) startEdit(span);
  });
})();
</script>

<div class="row px-4">
  <table class="table table-borderless">
      <thead>
        <tr>
          <td>
              <%= link_to 'Edit', edit_employee_path(@employee), class: 'btn btn-warning' %>
              <%= link_to 'Delete', employee_path(@employee), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger' %>
              <%= link_to "Back to employees", employees_path, class: 'btn btn-secondary' %>
          </td>
        </tr>
      </thead>
  </table>
</div>
