
<script type="module">
import * as primitives from 'primitives';

var control;
var items = [];

document.addEventListener('DOMContentLoaded', function () {

	var options = new primitives.OrgConfig();

	<% @employees.each do |employee| %>
		var itemTitleColor = primitives.Colors.RoyalBlue;
		<% if employee.direct_reports.count > 0 %>
			itemTitleColor = primitives.Colors.Green;
		<% end %>
		items.push(new primitives.OrgItemConfig({
			id: <%= employee.id %>,
			parent: null,
			title: "<%= employee.person_id %>",
			description: "<%= employee.title %>",
			groupTitle: "<%= employee.job_code %>",
			itemTitleColor: itemTitleColor
		}));
		<% if employee.direct_reports.count > 0 %>
			getDirectReports(<%= employee.id %>);
		<% end %>
	<% end %>

	options.items = items;
	options.cursorItem = 0;
	options.hasSelectorCheckbox = primitives.Enabled.False;
	options.onCursorChanging = function (e, data) {
		if (data.context !== null) {
			getDirectReports(data.context.id);
		}
	};

	control = primitives.OrgDiagram(document.getElementById("basicdiagram"), options);
});

function getDirectReports(managerId) {
	return fetch(`/employees/${managerId}/direct_reports.json`, {
		method: 'GET'
	})
	.then(response => response.json())
	.then(data => {
		data.forEach(report => {
			if (!items.some(item => item.id === report.employee.id)) {
				items.push(new primitives.OrgItemConfig({
					id: report.employee.id,
					parent: managerId,
					title: report.employee.person_id,
					description: report.employee.title,
					groupTitle: report.employee.job_code,
				}));
			}
		});
		control.setOptions = {items: items};
		control.update(primitives.UpdateMode.Refresh);
	})
	.catch(error => {
		console.error('Error:', error);
	});
}

</script>

<div class="container-md">
    <div class="d-flex justify-content-center">
        <div class="content-md" id="basicdiagram" style="width: 1200px; height: 800px; border-style: dotted; border-width: 1px;"></div>
    </div>
</div>
