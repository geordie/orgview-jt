
<script type="module">
import * as primitives from 'primitives';

var control;
var timer = null;

document.addEventListener('DOMContentLoaded', function () {
	var options = new primitives.OrgConfig();

	var items = [];

	<% @employees.each do |employee| %>
		items.push(new primitives.OrgItemConfig({
			id: <%= employee.id %>,
			parent: <%= employee.manager_id || "null" %>,
			title: "<%= employee.name %>",
			description: "<%= employee.title %>",
			image: "/images/photos/a.png",
			groupTitle: "<%= employee.job_function %>"
		}));
	<% end %>

	options.items = items;
	options.cursorItem = 0;
	options.hasSelectorCheckbox = primitives.Enabled.False;

	control = primitives.OrgDiagram(document.getElementById("basicdiagram"), options);
});

</script>

<div class="container-md">
    <div class="d-flex justify-content-center">
        <div class="content-md" id="basicdiagram" style="width: 900px; height: 600px; border-style: dotted; border-width: 1px;"></div>
    </div>
</div>