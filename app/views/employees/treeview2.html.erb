
<script type="module">
import * as primitives from 'primitives';

var control;
var items = [];

document.addEventListener('DOMContentLoaded', function () {

	var options = new primitives.OrgConfig();
	
	<% @employees.each do |employee| %>
		items.push(new primitives.OrgItemConfig({
			id: <%= employee.id %>,
			parent: <%= employee.manager_id || "null" %>,
			title: "<%= employee.name %>",
			description: "<%= employee.title %>",
			image: "/images/photos/a.png",
			groupTitle: "<%= employee.job_function %>"
		}));
	<% end %>

	options.items = items;
	options.cursorItem = 0;
	options.hasSelectorCheckbox = primitives.Enabled.False;
	options.onCursorChanging = function (e, data) {

		if (data.context !== null) {
			console.log(data);
			// Get the direct reports of the selected employee
			getDirectReports(data.context.id);
		}
	};

	control = primitives.OrgDiagram(document.getElementById("basicdiagram"), options);
});

function getDirectReports(managerId) {
	// Make a GET request to fetch data for the selected employee
	fetch(`/employees/${managerId}/direct_reports.json`, {
		method: 'GET'
	})
	.then(response => response.json())
	.then(data => {
		console.log(data);
		var newItems = [];
		// Add child nodes to the clicked node based on data
		data.forEach(report => {
			if (!items.some(item => item.id === report.employee.id)) {
				items.push(new primitives.OrgItemConfig({
					id: report.employee.id,
					parent: managerId,
					title: report.employee.name,
					description: report.employee.title,
					image: "/images/photos/a.png",
					groupTitle: report.employee.job_function
				}));
			}
		});
		control.setOptions = {items: items};
		control.update(primitives.UpdateMode.Refresh);
		console.log(items);
		
	})
	.catch(error => {
		console.error('Error:', error);
	});
}

</script>

<div class="container-md">
    <div class="d-flex justify-content-center">
        <div class="content-md" id="basicdiagram" style="width: 900px; height: 600px; border-style: dotted; border-width: 1px;"></div>
    </div>
</div>