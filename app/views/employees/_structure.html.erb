
<% employees.each do |employee| %>
  <ul>
    <div class="accordion-item">
      <h2 class="accordion-header" id="heading<%= employee[:employee].id %>">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="<%= (employee[:directs_count]>0 ? 'collapse' : nil)%>" data-bs-target="#collapse<%= employee[:employee].id %>" aria-expanded="false" aria-controls="collapse<%= employee[:employee].id %>" data-url="<%= direct_reports_path(employee[:employee].id) %>" data-directs-count="<%= employee[:directs_count] %>">
          <% unless employee[:directs_count] <= 0 %>
            <i class="bi bi-chevron-right me-2" id="icon<%= employee[:employee].id %>"></i>
          <% end %>
          <%= employee[:employee].display_name %> ( <%= employee[:employee].title %> )
        </button>
      </h2>

      <div id="collapse<%= employee[:employee].id %>" class="accordion-collapse collapse" aria-labelledby="heading<%= employee[:employee].id %>">
        <div class="accordion-body">
          <% unless employee[:direct_reports].empty? %>
            <%= render partial: 'structure', locals: { employees: employee[:direct_reports] } %>
          <% end %>
        </div>
      </div>
    </div>
  </ul>
<% end %>
