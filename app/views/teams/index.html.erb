<p style="color: green"><%= notice %></p>

<h1>Teams</h1>

<%= will_paginate_with_bootstrap @teams %>

<div class="row mb-3">
  <div class="col-md-6">
    <%= form_with url: teams_path, method: :get, local: true do %>
      <div class="input-group">
        <%= text_field_tag :search, params[:search], class: "form-control", placeholder: "Search by team name" %>
        <button class="btn btn-outline-secondary" type="submit">Search</button>
      </div>
    <% end %>
  </div>
</div>

<table class="table table-striped">
  <thead>
    <tr>
      <% common_params = { direction: params[:direction] == "asc" ? "desc" : "asc", depth: params[:depth], parent_id: params[:parent_id] } %>
        <th><%= link_to "Name", teams_path(common_params.merge(sort: "name")) %></th>
        <th>Pretty Name</th>
        <th style="text-align: center;"><%= link_to "Size", teams_path(common_params.merge(sort: "member_count")) %></th>
        <th style="text-align: center;"><%= link_to "Managers", teams_path(common_params.merge(sort: "manager_count")) %></th>
        <th style="text-align: center;"><%= link_to "Sub-Teams", teams_path(common_params.merge(sort: "children")) %></th>
        <th style="text-align: center;"><%= link_to "Descendents", teams_path(common_params.merge(sort: "descendents")) %></th>
        <th style="text-align: center;"><%= link_to "Org Size", teams_path(common_params.merge(sort: "org_member_count")) %></th>
        <th style="text-align: center;"><%= link_to "Org Health", teams_path(common_params.merge(sort: "team_health")) %></th>
      <th style="text-align: center;">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @teams.each do |team| %>
      <tr>
        <td data-bs-toggle="tooltip" title="<%= team.full_path %>">
          <%= link_to team.name, teams_path(parent_id: team.id) %></td>
        <td>
          <span class="pn-display"
                data-team-id="<%= team.id %>"
                data-original="<%= team.pretty_name.to_s %>">
            <%= team.pretty_name.presence || '<span class="text-muted small">—</span>'.html_safe %>
          </span>
        </td>
        <td style="text-align: center;"><%= team.member_count %></td>
        <td style="text-align: center;"><%= team.manager_count %></td>
        <td style="text-align: center;"><%= team.children %></td>
        <td style="text-align: center;"><%= team.descendents %></td>
        <td style="text-align: center;"><%= team.org_member_count %></td>
        <td data-bs-toggle="tooltip" title="<%= team.team_health_details %>" style="text-align: center;">
          <% if team.team_health == "amber" %>
        <span style="color: orange;">&#x25cf;</span>
          <% elsif team.team_health == "red" %>
        <span style="color: red;">&#x25cf;</span>
          <% else %>
        <span style="color: green;">&#x25cf;</span>
          <% end %>
        </td>

        <td style="text-align: center;">
            <div class="btn-group" role="group" style="gap: 8px;">
              <%= link_to 'Detail', team, class: 'btn btn-primary btn-sm' %>
              <button class="btn btn-outline-secondary btn-sm"
                      data-bs-toggle="modal" data-bs-target="#moveTeamModal"
                      data-team-id="<%= team.id %>" data-team-name="<%= team.pretty_name.presence || team.name %>">
                Move
              </button>
            </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render 'move_modal' %>

<script>
(function () {
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

  function startEdit(span) {
    const original = span.dataset.original;
    const input = document.createElement('input');
    input.type = 'text';
    input.value = original;
    input.className = 'form-control form-control-sm';
    input.style.width = '160px';
    span.replaceWith(input);
    input.focus();
    input.select();

    function save() {
      const value = input.value.trim();
      const teamId = span.dataset.teamId;
      fetch(`/teams/${teamId}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
          'Accept': 'application/json'
        },
        body: JSON.stringify({ team: { pretty_name: value } })
      })
      .then(r => r.ok ? r.json() : Promise.reject(r))
      .then(() => {
        span.dataset.original = value;
        if (value) {
          span.textContent = value;
        } else {
          span.innerHTML = '<span class="text-muted small">—</span>';
        }
        input.replaceWith(span);
        const moveBtn = span.closest('tr')?.querySelector('button[data-bs-target="#moveTeamModal"]');
        if (moveBtn) {
          const teamName = span.closest('tr')?.querySelector('td a')?.textContent?.trim() || '';
          moveBtn.dataset.teamName = value || teamName;
        }
      })
      .catch(() => {
        alert('Failed to save. Please try again.');
        input.replaceWith(span);
      });
    }

    function cancel() {
      input.replaceWith(span);
    }

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); save(); }
      if (e.key === 'Escape') { cancel(); }
    });
    input.addEventListener('blur', save);
  }

  document.addEventListener('click', function (e) {
    const span = e.target.closest('span.pn-display');
    if (span) startEdit(span);
  });
})();
</script>
