<%= form_with(model: team, local: true) do |form| %>
  <% if team.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% team.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :full_path, class: "form-label" %>
    <%= form.text_field :full_path, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :parent_id, class: "form-label" %>
    <%= form.number_field :parent_id, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :depth, class: "form-label" %>
    <%= form.number_field :depth, class: "form-control" %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
<% end %>
