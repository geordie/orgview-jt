
<script type="module">
import * as primitives from 'primitives';

var control;
var items = [];

document.addEventListener('DOMContentLoaded', function () {

	var options = new primitives.OrgConfig();

	<% @teams.each do |team| %>
		var itemTitleColor = primitives.Colors.Green;
		<% if team.team_health == "red" %>
			itemTitleColor = primitives.Colors.Red;
		<% elsif team.team_health == "amber" %>
			itemTitleColor = primitives.Colors.Orange;
		<% end %>
		items.push(new primitives.OrgItemConfig({
			id: <%= team.id %>,
			parent: <%= team.parent_id || "null" %>,
			title: "<%= team.name %>",
			full_path: "<%= team.full_path %>",
			org_member_count: <%= team.org_member_count %>,
			member_count: <%= team.member_count %>,
			manager_count: <%= team.manager_count %>,
			team_health: "<%= team.team_health %>",
			team_health_details: "<%= team.team_health_details %>",
			children: <%= team.children %>,
			descendents: <%= team.descendents %>,
			itemTitleColor: itemTitleColor
		}));
		<% if team.sub_teams.count > 0 %>
			getSubTeams(<%= team.id %>);
		<% end %>
	<% end %>

	options.items = items;
	options.cursorItem = 0;
	options.templates = [getTeamTemplate()];
	options.defaultTemplateName = "teamTemplate";
	options.onItemRender = onTemplateRender;
	options.normalItemsInterval = 10;
	options.normalLevelShift = 44;
	options.padding = { left: 10, top: 20, right: 10, bottom: 10};
	options.hasSelectorCheckbox = primitives.Enabled.False;
	options.onCursorChanged = onNodeHighlighted;

	control = primitives.OrgDiagram(document.getElementById("basicdiagram"), options);
});

function onNodeHighlighted(event, data) {
	document.getElementById("sidecontainer").innerHTML = data.context.title
		+ "<br/>" + data.context.full_path;
	getTeamMembers(data.context.id)
		.then( response => {
			tableCreate(response);
		}
	);
}

function tableCreate(teamMembers) {
	const sideContainer = document.getElementById("sidecontainer");
	var tbl = document.createElement('table');
	tbl.style.width = '498px';
	tbl.style.border = '1px solid black';

	var tr = tbl.insertRow();
	var td0 = tr.insertCell();
	var td1 = tr.insertCell();
	var td2 = tr.insertCell();
	td0.appendChild(document.createTextNode("Person ID"));
	td1.appendChild(document.createTextNode("Title"));
	td2.appendChild(document.createTextNode("Manager ID"));
	Array.from(tr.cells).forEach(cell => {
			cell.style.border = '1px solid black';
			cell.style.padding = '3px';});

	teamMembers.forEach(teamMember => {
		tr = tbl.insertRow();
		td0 = tr.insertCell();
		td1 = tr.insertCell();
		td2 = tr.insertCell();
		td0.appendChild(document.createTextNode(teamMember.employee.person_id));
		td1.appendChild(document.createTextNode(teamMember.employee.title));
		td2.appendChild(document.createTextNode(teamMember.employee.manager_id));

		Array.from(tr.cells).forEach(cell => {
			cell.style.border = '1px solid black';
			cell.style.padding = '3px';});
	});

	sideContainer.appendChild(tbl);
}

function onTemplateRender(event, data) {
	switch (data.renderingMode) {
		case primitives.RenderingMode.Create:
			break;
		case primitives.RenderingMode.Update:
			break;
	}

	var itemConfig = data.context;

	if (data.templateName == "teamTemplate") {
		var element = data.element;

		element.firstChild.style.backgroundColor = itemConfig.itemTitleColor || primitives.Colors.RoyalBlue;
		element.firstChild.firstChild.textContent = itemConfig.title;

		element.childNodes[1].innerHTML = '<strong>ID:</strong> ' + itemConfig.id;
		element.childNodes[2].innerHTML = '<strong>Org Size:</strong> ' + itemConfig.org_member_count;
		element.childNodes[3].innerHTML = '<strong>Team Size:</strong> ' + itemConfig.member_count;
		element.childNodes[4].innerHTML = '<strong>Managers:</strong> ' + itemConfig.manager_count;
		element.childNodes[5].innerHTML = '<strong>Sub-Teams:</strong> ' + itemConfig.children;
		element.childNodes[6].innerHTML = '<strong>Descendents:</strong> ' + itemConfig.descendents;
		element.childNodes[7].innerHTML = '<strong>Team Health:</strong> ';
		element.childNodes[8].innerHTML = itemConfig.team_health_details;
	}
}

function getTeamMembers(teamId) {
	return fetch(`/teams/${teamId}/team_members.json`, {
		method: 'GET'
	})
	.then(response => response.json())
	.then(data => {
		return data;
	})
	.catch(error => {
		console.error('Error:', error);
	});
}

function getSubTeams(parentId) {
	fetch(`/teams/${parentId}/sub_teams.json`, {
		method: 'GET'
	})
	.then(response => response.json())
	.then(data => {
		data.forEach(sub_team => {
			if (!items.some(item => item.id === sub_team.sub_team.id)) {

				var itemTitleColor = primitives.Colors.Green;

				if ( sub_team.sub_team.team_health == "red" )
					itemTitleColor = primitives.Colors.Red;
				else if ( sub_team.sub_team.team_health == "amber" )
					itemTitleColor = primitives.Colors.Orange;

				items.push(new primitives.OrgItemConfig({
					id: sub_team.sub_team.id,
					parent: parentId,
					title: sub_team.sub_team.name,
					full_path: sub_team.sub_team.full_path,
					org_member_count: sub_team.sub_team.org_member_count,
					member_count: sub_team.sub_team.member_count,
					manager_count: sub_team.sub_team.manager_count,
					team_health: sub_team.sub_team.team_health,
					team_health_details: sub_team.sub_team.team_health_details,
					children: sub_team.sub_team.children,
					descendents: sub_team.sub_team.descendents,
					itemTitleColor: itemTitleColor
				}));
				if(sub_team.sub_team_count > 0) {
					getSubTeams(sub_team.sub_team.id);
				}
			}
		});
		control.setOptions = {items: items};
		control.update(primitives.UpdateMode.Refresh);

	})
	.catch(error => {
		console.error('Error:', error);
	});
}

function getTeamTemplate() {
	var result = new primitives.TemplateConfig();
	result.name = "teamTemplate";

	result.itemSize = new primitives.Size(240, 150);
	result.minimizedItemSize = new primitives.Size(12, 12);

	result.itemTemplate = ["div",
		{
			"style": {
				width: result.itemSize.width + "px",
				height: result.itemSize.height + "px"
			},
			"class": ["bp-item", "bp-corner-all", "bt-item-frame"]
		},
		["div",
			{
				name: "titleBackground",
				style: {
					top: "2px",
					left: "2px",
					width: "238px",
					height: "20px",
					overflow: "hidden"
				},
				"class": ["bp-item", "bp-corner-all", "bp-title-frame"]
			},
			["div",
				{
					name: "title",
					style: {
						top: "2px",
						left: "2px",
						width: "228px",
						height: "18px",
						fontSize: "12px",
						overflow: "hidden"
					},
					"class": ["bp-item", "bp-title"]
				}
			]
		],
		["div",
			{
				name: "team_id",
				style: {
					top: "30px",
					left: "10px",
					width: "162px",
					height: "36px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "org_member_count",
				style: {
					top: "30px",
					left: "110px",
					width: "162px",
					height: "36px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "member_count",
				style: {
					top: "50px",
					left: "10px",
					width: "162px",
					height: "36px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "manager_count",
				style: {
					top: "70px",
					left: "10px",
					width: "162px",
					height: "36px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "children",
				style: {
					top: "50px",
					left: "110px",
					width: "162px",
					height: "36px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "descendents",
				style: {
					top: "70px",
					left: "110px",
					width: "162px",
					height: "36px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "health-heading",
				style: {
					top: "90px",
					left: "10px",
					width: "200px",
					height: "24px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "health-details",
				style: {
					top: "110px",
					left: "10px",
					width: "200px",
					height: "52px",
					fontSize: "12px",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		],
		["div",
			{
				name: "label",
				style: {
					top: "-20px",
					left: "3px",
					width: "208px",
					height: "20px",
					fontSize: "14px",
					textAlign: "center",
					overflow: "hidden"
				},
				"class": "bp-item"
			}
		]
	];

	return result;
}

</script>

<div style="width: 100%">
  <div class="d-flex">
    <div class="content-md" id="basicdiagram" style="width: 80%; height: 800px; border-style: dotted; border-width: 1px; margin: 10px;"></div>
    <div class="content-md" id="sidecontainer" style="width: 20%; height: 800px; border-style: dotted; border-width: 1px; margin: 10px;"></div>
  </div>
</div>
