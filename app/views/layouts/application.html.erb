<!DOCTYPE html>
<html>
  <head>
    <title>Workspace</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <%= javascript_importmap_tags %>
    <%= yield :head%>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
      <%= link_to "Grainger Org View", root_path, class: "navbar-brand" %>
      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="employeesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Employees
          </a>
          <ul class="dropdown-menu" aria-labelledby="employeesDropdown">
            <li><%= link_to "Roles", roles_path, class: "dropdown-item" %></li>
            <li><%= link_to "List", employees_path, class: "dropdown-item" %></li>
            <li><%= link_to "Structure", employees_structure_path, class: "dropdown-item" %></li>
          </ul>
          </li>
          <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="employeesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Squads
          </a>
          <ul class="dropdown-menu" aria-labelledby="employeesDropdown">
            <li><%= link_to "List", squads_path, class: "dropdown-item" %></li>
            <li><%= link_to "Structure", squads_treeview_path, class: "dropdown-item" %></li>
          </ul>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="reportsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Reports
            </a>
            <ul class="dropdown-menu" aria-labelledby="reportsDropdown">
              <li><%= link_to "Employee Countries", reports_employee_country_path, class: "dropdown-item" %></li>
              <li><%= link_to "Employee Worker Types", reports_employee_worker_type_path, class: "dropdown-item" %></li>
              <li><%= link_to "Employee Worker Types by Country", reports_employee_country_worker_type_path, class: "dropdown-item" %></li>
              <li><%= link_to "Employee Roles", reports_roles_path, class: "dropdown-item" %></li>
              <li><%= link_to "Employee Role Density", reports_title_density_path, class: "dropdown-item" %></li>
            <li><%= link_to "Employee Job Function", reports_job_function_path, class: "dropdown-item" %></li>
            <li><%= link_to "Employee Job Function Groups", reports_job_function_group_path, class: "dropdown-item" %></li>
            <li><%= link_to "Employee Seniority", reports_seniority_path, class: "dropdown-item" %></li>
            <li><%= link_to "Employee Management Ratios", reports_management_ratios_path, class: "dropdown-item" %></li>
            <li><%= link_to "Employee Squad Allocations", reports_employee_allocations_path, class: "dropdown-item" %></li>
            <li><%= link_to "Team Geographies", reports_team_geos_path, class: "dropdown-item" %></li>
            <li><%= link_to "Squad Size", reports_squad_size_path, class: "dropdown-item" %></li>
            <li><%= link_to "Squad Depth", reports_squad_depth_path, class: "dropdown-item" %></li>
            <li><%= link_to "Squad Health", reports_squad_health_path, class: "dropdown-item" %></li>
            <li><%= link_to "Squad Health Details", reports_squad_health_details_path, class: "dropdown-item" %></li>
            <li><%= link_to "Squad Children", reports_squad_children_path, class: "dropdown-item" %></li>
            <li><%= link_to "Squad Members Managers", reports_squad_members_managers_path, class: "dropdown-item" %></li>
          </ul>
        </li>
      </ul>

      <!-- Data Version Badge on the right side -->
      <ul class="navbar-nav ms-auto">
        <% if @current_data_version %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="dataVersionDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <span class="badge <%= @current_data_version.active? ? 'bg-primary' : 'bg-warning' %> me-2">
                <i class="bi bi-database"></i> <%= @current_data_version.name %>
                <% unless @current_data_version.active? %>
                  <i class="bi bi-exclamation-triangle ms-1"></i>
                <% end %>
              </span>
              <small class="text-muted">Data Version</small>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dataVersionDropdown">
              <li class="dropdown-header">Switch Data Version</li>
              <% unless @current_data_version.active? %>
                <li><small class="dropdown-item-text text-warning">⚠️ No active version set</small></li>
              <% end %>
              <li><hr class="dropdown-divider"></li>
              <% @all_data_versions.each do |version| %>
                <li>
                  <%= link_to activate_data_version_path(version), method: :patch, class: "dropdown-item #{'active' if version.active?}",
                      data: {
                        turbo_method: :patch
                      } do %>
                    <div class="d-flex justify-content-between align-items-center">
                      <span>
                        <%= version.name %>
                        <% if version.active? %>
                          <i class="bi bi-check-circle text-success ms-1"></i>
                        <% end %>
                      </span>
                      <small class="text-muted"><%= version.snapshot_date.strftime("%m/%d/%y") %></small>
                    </div>
                  <% end %>
                </li>
              <% end %>
              <li><hr class="dropdown-divider"></li>
              <li><%= link_to "Manage Versions", data_versions_path, class: "dropdown-item" %></li>
            </ul>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to data_versions_path, class: "nav-link" do %>
              <span class="badge bg-danger me-2">
                <i class="bi bi-exclamation-triangle"></i> No Data
              </span>
              <small class="text-muted">No Versions</small>
            <% end %>
          </li>
        <% end %>
      </ul>
      </div>
    </nav>
    <%= yield %>
  </body>
</html>
