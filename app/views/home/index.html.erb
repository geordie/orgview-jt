<p style="color: green"><%= notice %></p>
<p style="color: red"><%= alert %></p>

<h1>Welcome to OrgView CBA</h1>

<div class="container" style="border: 1px solid #ccc; border-radius: 8px; padding: 16px; margin-top: 20px;">

<h2>Data Import and Generation</h2>

  <div class="row" style="border: 1px solid #ccc; border-radius: 8px; padding: 16px; margin-top: 20px;">
    <div class="col-4">
      <h5>Step 1: Import employee data</h5>
    </div>
    <div class="col-8">
      <%= form_with url: import_csv_employees_path, local: true, html: { multipart: true, id: "import-form" } do |form| %>
        <div class="mb-3 d-flex align-items-center" style="width: 50%; margin-top: 40px;">
          <%= text_field_tag :file_name, nil, class: "form-control me-2", id: "file-name", placeholder: "Select a CSV File", readonly: true %>
          <%= form.label :csv_file, "...", class: "btn btn-primary btn-sm me-5", id: "file-label", style: "height: 2.5rem;" %>
          <%= form.file_field :csv_file, style: "display: none;", id: "file-input", accept: '.csv' %>
          <%= form.submit "Import", class: "btn btn-success", id: "import-button", disabled: true %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="row" style="border: 1px solid #ccc; border-radius: 8px; padding: 16px; margin-top: 20px;">
    <div class="col-4">
      <h5>Step 2: Generate Roles</h5>
    </div>
    <div class="col-3">
      <%= form_with url: build_cba_roles_path, method: :post, style: "display: inline-block; margin: 0;" do %>
        <%= submit_tag 'Go', class: 'btn btn-success' %>
      <% end %>
    </div>
  </div>

  <div class="row" style="border: 1px solid #ccc; border-radius: 8px; padding: 16px; margin-top: 20px;">
    <div class="col-4">
      <h5>Step 3: Generate Employees</h5>
    </div>
    <div class="col-3">
      <%= form_with url: build_cba_list_employees_path, method: :post, style: "display: inline-block; margin: 0;" do %>
        <%= submit_tag 'Go', class: 'btn btn-success' %>
      <% end %>
    </div>
  </div>

  <div class="row" style="border: 1px solid #ccc; border-radius: 8px; padding: 16px; margin-top: 20px;">
    <div class="col-4">
      <h5>Step 4: Generate Squads</h5>
    </div>
    <div class="col-3">
      <%= form_with url: '/squads/build_cba_squads_list', method: :post, style: "display: inline-block; margin: 0;" do %>
        <%= submit_tag 'Go', class: 'btn btn-success' %>
      <% end %>
    </div>
  </div>

  <div class="row" style="border: 1px solid #ccc; border-radius: 8px; padding: 16px; margin-top: 20px;">
    <div class="col-4">
      <h5>Step 5: Generate Squad Stats</h5>
    </div>
    <div class="col-3">
      <%= form_with url: squads_build_all_squads_stats_path, method: :post, style: "display: inline-block; margin: 0;" do %>
        <%= submit_tag 'Go', class: 'btn btn-success' %>
      <% end %>
    </div>
  </div>

</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var fileInput = document.getElementById("file-input");
    var fileName = document.getElementById("file-name");
    var importButton = document.getElementById("import-button");
    var fileLabel = document.getElementById("file-label");
    if(fileLabel && fileInput) {
      fileLabel.addEventListener("click", function() {
        fileInput.click();
      });
      fileInput.addEventListener("change", function() {
        if (fileInput.files.length > 0) {
          fileName.value = fileInput.files[0].name;
          importButton.disabled = false;
        } else {
          fileName.value = "";
          importButton.disabled = true;
        }
      });
    }
  });
</script>
